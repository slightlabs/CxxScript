{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CxxScript",
  "scopeName": "source.cxxscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#declarations" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cxxscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cxxscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cxxscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cxxscript",
              "match": "\\\\(n|t|r|0|\\\\|\"|'|\\$|.)"
            },
            {
              "name": "meta.interpolation.cxxscript",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.cxxscript",
          "match": "'(?:\\\\.|[^\\\\'])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hexadecimal.cxxscript",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.cxxscript",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.cxxscript",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.cxxscript",
          "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][+-]?[0-9]+)?[fF]?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+[fF]?\\b|\\b[0-9][0-9_]*[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.cxxscript",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cxxscript",
          "match": "\\b(if|else|while|do|for|switch|case|default|break|continue|return|try|catch|finally|throw|import)\\b"
        },
        {
          "name": "storage.modifier.cxxscript",
          "match": "\\b(const)\\b"
        },
        {
          "name": "constant.language.cxxscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.this.cxxscript",
          "match": "\\b(this)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cxxscript",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|double|string|bool|char|void|auto|map|fn)\\b"
        },
        {
          "name": "meta.declaration.type.cxxscript",
          "match": "\\b(struct|enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.cxxscript" },
            "2": { "name": "entity.name.type.cxxscript" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.cxxscript",
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.cxxscript" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.cxxscript",
          "match": "\\b(len|push|pop|insert|removeAt|clear|has|remove|keys|values|size|substr|charAt|indexOf|contains|startsWith|endsWith|toUpper|toLower|trim|replace|split|join|repeat|reverse|format|abs|min|max|clamp|pow|sqrt|floor|ceil|round|trunc|fmod|sin|cos|tan|asin|acos|atan|atan2|exp|log|log10|random|randInt|srand|pi|toInt|toUInt|toDouble|toFloat|toString|toBool|toChar|parseInt|parseDouble|typeof|isArray|isMap|print|println|error|assert)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cxxscript",
          "match": "(<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|<=|>=|==|!=|&&|\\|\\||\\+\\+|--|->|[-+*/%<>=!&|^~?:])"
        }
      ]
    }
  }
}
